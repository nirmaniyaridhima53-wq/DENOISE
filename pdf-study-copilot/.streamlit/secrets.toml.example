# ============================================================
# STREAMLIT SECRETS TEMPLATE
# ============================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to "secrets.toml"
#    (Command: cp .streamlit/secrets.toml.example .streamlit/secrets.toml)
# 2. Fill in your actual API keys in the new "secrets.toml" file.
# 3. NEVER commit "secrets.toml" to GitHub! (It is in .gitignore)
# ============================================================

# ==========================================
# AI PROVIDER CONFIGURATION
# ==========================================
# Choose your provider: "xai" (for Grok) or "groq"
AI_PROVIDER = "xai"

# ------------------------------------------
# OPTION 1: xAI (Grok)
# ------------------------------------------
# Get your API key from: https://console.x.ai/
XAI_API_KEY = "xai-YOUR_XAI_API_KEY_HERE"
XAI_MODEL = "grok-beta" 
# Note: Use "grok-beta", "grok-2", or whatever model name 
# is currently available in your xAI dashboard.

# ------------------------------------------
# OPTION 2: Groq (Fast Open Source Models)
# ------------------------------------------
# Get your API key from: https://console.groq.com/
GROQ_API_KEY = "gsk_YOUR_GROQ_API_KEY_HERE"
GROQ_MODEL = "llama-3.3-70b-versatile" 

# Note: Other good options: "mixtral-8x7b-32768", "gemma2-9b-it"

# ==========================================
# OPTIONAL: YOUTUBE DATA API (For future upgrade)
# ==========================================
# For the MVP, we generate YouTube Search URLs directly, 
# so an API key is NOT required yet.
# YOUTUBE_API_KEY = "YOUR_YOUTUBE_API_KEY_HERE"
